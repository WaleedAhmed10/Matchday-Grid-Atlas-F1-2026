# ===================================
# F1 2026 GP Season Calculator
# Environment Configuration
# ===================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For local development:
# MONGODB_URI=mongodb://localhost:27017/f1-predictor
#
# For production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/f1-predictor
#
# Get connection string from: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb://localhost:27017/f1-predictor

# Security
# Generate secure JWT secret: openssl rand -base64 32
# Minimum 32 characters, use strong random string
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_chars

# Logging
# Options: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# ===================================
# IMPORTANT PRODUCTION SETTINGS
# ===================================
# Before deploying to production, make sure:
# 1. NODE_ENV=production
# 2. JWT_SECRET is a strong, random string
# 3. MONGODB_URI uses Atlas (cloud) or secure server
# 4. Database backups are configured
# 5. CORS is configured for your domain

# ===================================
# RACE RESULTS & POINTS (automatic)
# ===================================
# Results are pulled from the free Jolpica F1 API after every GP, which updates
# driver/constructor standings, the simulation and the player leaderboard.
# RESULTS_SYNC=off                 # disable automatic sync
# RESULTS_SYNC_INTERVAL_MIN=30     # how often the server checks for new results
# F1_SEASON=2026

# Usernames (comma separated) allowed to enter results manually / force a sync:
#   POST /api/championship/results  and  POST /api/championship/sync
ADMIN_USERNAMES=

# Old accounts (created before passwords) can be claimed only from the browser they were
# created in. Set true to let anyone claim them by signing in with a new password.
# ALLOW_LEGACY_CLAIM=false
# Days a sign-in stays valid (default 30)
# SESSION_DAYS=30

# Set to 1 when the API runs behind a reverse proxy (Render, Railway, Heroku, nginx)
# TRUST_PROXY=1

# ===================================
# FRONTEND (client/.env, read at build time)
# ===================================
# The frontend calls /api by default. If the API is hosted somewhere else
# (e.g. the frontend is on Vercel and the API on Render), set its full URL
# when building the client, otherwise sign-in cannot reach the server:
# VITE_API_URL=https://your-api.example.com/api
